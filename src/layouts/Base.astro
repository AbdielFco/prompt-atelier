---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Prompt Atelier — Ingeniería de prompts</title>
    <meta
      name="description"
      content="Roadmap de ingeniería de prompts: anatomía, técnicas, patrones, software y agentes."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;1,9..144,500&family=Inter:wght@400;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        if (localStorage.getItem("prompt-atelier-theme") === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        }
      } catch (error) {
        console.error("prompt-atelier: cannot read theme", error);
      }
    </script>
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
