---
import Base from "./Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";

const { skip = "#inicio" } = Astro.props;
---

<Base>
  <a class="skip" href={skip} data-i18n="skip">Saltar al contenido</a>
  <Sidebar />
  <main class="scroller" data-scroller>
    <article class="doc">
      <slot />
      <Footer />
    </article>
  </main>
</Base>
